<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fieldset>
        <field
            name="id"
            type="text"
            label="JGLOBAL_FIELD_ID_LABEL"
            default="0"
            class="readonly"
            readonly="true"
        />

        <field
            name="name"
            type="text"
            label="COM_YSINVENTORY_FIELD_NAME_LABEL"
            required="true"
        />

        <field
            name="alias"
            type="text"
            label="JFIELD_ALIAS_LABEL"
            description="JFIELD_ALIAS_DESC"
            hint="JFIELD_ALIAS_PLACEHOLDER"
        />

        <field
            name="ysi_contact_user_id"
            type="user"
            label="COM_YSINVENTORY_FIELD_LOCATION_USER_LABEL"
            description="COM_YSINVENTORY_FIELD_LOCATION_USER_DESC"
            required="true"
        />

        <field
            name="published"
            type="list"
            label="JSTATUS"
            default="1"
            class="form-select-color-state"
            validate="options"
        >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="-2">JTRASHED</option>
        </field>

        <field
            name="ordering"
            type="number"
            label="JFIELD_ORDERING_LABEL"
            default="0"
            min="0"
            step="1"
            filter="int"
        />
    </fieldset>

    <fields name="params">
        <fieldset name="basic" label="JGLOBAL_FIELDSET_BASIC">
        </fieldset>
    </fields>

    <fieldset name="publishing" label="JGLOBAL_FIELDSET_PUBLISHING">
        <field
            name="created"
            type="calendar"
            label="JGLOBAL_FIELD_CREATED_LABEL"
            translateformat="true"
            showtime="true"
            size="22"
            filter="user_utc"
        />

        <field
            name="created_by"
            type="user"
            label="JGLOBAL_FIELD_CREATED_BY_LABEL"
            filter="unset"
        />

        <field
            name="modified"
            type="calendar"
            label="JGLOBAL_FIELD_MODIFIED_LABEL"
            translateformat="true"
            showtime="true"
            size="22"
            readonly="true"
            filter="user_utc"
        />

        <field
            name="modified_by"
            type="user"
            label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
            readonly="true"
            filter="unset"
        />
    </fieldset>
</form>