<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            inputmode="search"
            label="COM_YSINVENTORY_FILTER_ITEMS_SEARCH_LABEL"
            description="COM_YSINVENTORY_FILTER_ITEMS_SEARCH_DESC"
            hint="JSEARCH_FILTER"
        />

        <field
            name="published"
            type="status"
            label="JSTATUS"
            class="js-select-submit-on-change"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>

        <field
            name="ysi_status"
            type="list"
            label="COM_YSINVENTORY_FIELD_ASSET_STATUS_LABEL"
            class="js-select-submit-on-change"
        >
            <option value="">COM_YSINVENTORY_FILTER_SELECT_ASSET_STATUS</option>
            <option value="1">COM_YSINVENTORY_ASSET_STATUS_IN_STOCK</option>
            <option value="2">COM_YSINVENTORY_ASSET_STATUS_ON_LOAN</option>
            <option value="3">COM_YSINVENTORY_ASSET_STATUS_MAINTENANCE</option>
            <option value="4">COM_YSINVENTORY_ASSET_STATUS_LOST</option>
        </field>

        <field
            name="ysi_inventory_id"
            type="sql"
            label="COM_YSINVENTORY_FIELD_INVENTORY_LABEL"
            class="js-select-submit-on-change"
            query="SELECT id AS value, name AS text FROM #__ysi_inventories WHERE published != -2 ORDER BY name"
            key_field="value"
            value_field="text"
        >
            <option value="">COM_YSINVENTORY_SELECT_INVENTORY</option>
        </field>

        <field
            name="brand_id"
            type="sql"
            label="COM_YSINVENTORY_FIELD_BRAND_LABEL"
            class="js-select-submit-on-change"
            query="SELECT id AS value, name AS text FROM #__ysi_brands WHERE published != -2 ORDER BY name"
            key_field="value"
            value_field="text"
        >
            <option value="">COM_YSINVENTORY_SELECT_BRAND</option>
        </field>

        <field
            name="catid"
            type="sql"
            label="COM_YSINVENTORY_FIELD_CATEGORY_LABEL"
            class="js-select-submit-on-change"
            query="SELECT id AS value, title AS text FROM #__ysi_categories WHERE published != -2 AND level > 0 ORDER BY lft"
            key_field="value"
            value_field="text"
        >
            <option value="">COM_YSINVENTORY_SELECT_CATEGORY</option>
        </field>
    </fields>

    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="JGLOBAL_SORT_BY"
            default="a.name ASC"
            class="js-select-submit-on-change"
            validate="options"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.ordering ASC">JGRID_HEADING_ORDERING_ASC</option>
            <option value="a.ordering DESC">JGRID_HEADING_ORDERING_DESC</option>
            <option value="a.published ASC">JSTATUS_ASC</option>
            <option value="a.published DESC">JSTATUS_DESC</option>
            <option value="a.name ASC">JGLOBAL_NAME_ASC</option>
            <option value="a.name DESC">JGLOBAL_NAME_DESC</option>
            <option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
            <option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
        </field>

        <field
            name="limit"
            type="limitbox"
            label="JGLOBAL_LIST_LIMIT"
            default="25"
            class="js-select-submit-on-change"
        />
    </fields>
</form>