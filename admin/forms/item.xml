<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fieldset>
        <field
            name="id"
            type="text"
            label="JGLOBAL_FIELD_ID_LABEL"
            default="0"
            class="readonly"
            readonly="true"
        />

        <field
            name="name"
            type="text"
            label="COM_YSINVENTORY_FIELD_ASSET_NAME_LABEL"
            required="true"
        />

        <field
            name="alias"
            type="text"
            label="JFIELD_ALIAS_LABEL"
            description="JFIELD_ALIAS_DESC"
            hint="JFIELD_ALIAS_PLACEHOLDER"
        />

        <field
            name="ysi_inventory_id"
            type="sql"
            label="COM_YSINVENTORY_FIELD_INVENTORY_LABEL"
            description="COM_YSINVENTORY_FIELD_INVENTORY_DESC"
            required="true"
            key_field="value"
            value_field="text"
            query="SELECT id AS value, name AS text FROM #__ysi_inventories WHERE published = 1 ORDER BY name"
        >
            <option value="">COM_YSINVENTORY_SELECT_INVENTORY</option>
        </field>

        <field
            name="catid"
            type="sql"
            label="COM_YSINVENTORY_FIELD_CATEGORY_LABEL"
            description="COM_YSINVENTORY_FIELD_CATEGORY_DESC"
            required="true"
            key_field="value"
            value_field="text"
            query="SELECT id AS value, title AS text FROM #__ysi_categories WHERE published = 1 AND level > 0 ORDER BY lft"
        >
            <option value="">COM_YSINVENTORY_SELECT_CATEGORY</option>
        </field>

        <field
            name="brand_id"
            type="sql"
            label="COM_YSINVENTORY_FIELD_BRAND_LABEL"
            description="COM_YSINVENTORY_FIELD_BRAND_DESC"
            required="true"
            key_field="value"
            value_field="text"
            query="SELECT id AS value, name AS text FROM #__ysi_brands WHERE published = 1 ORDER BY name"
        >
            <option value="">COM_YSINVENTORY_SELECT_BRAND</option>
        </field>

        <field
            name="ysi_location_user_id"
            type="user"
            label="COM_YSINVENTORY_FIELD_LOCATION_LABEL"
            description="COM_YSINVENTORY_FIELD_LOCATION_DESC"
            required="true"
        />

        <field
            name="image"
            type="media"
            label="COM_YSINVENTORY_FIELD_IMAGE_LABEL"
            description="COM_YSINVENTORY_FIELD_ITEM_IMAGE_DESC"
            directory="com_ysinventory/items"
        />

        <field
            name="ysi_model"
            type="text"
            label="COM_YSINVENTORY_FIELD_MODEL_LABEL"
            description="COM_YSINVENTORY_FIELD_MODEL_DESC"
        />

        <field
            name="ysi_serial_number"
            type="text"
            label="COM_YSINVENTORY_FIELD_SERIAL_NUMBER_LABEL"
            description="COM_YSINVENTORY_FIELD_SERIAL_NUMBER_DESC"
        />

        <field
            name="ysi_sku"
            type="text"
            label="COM_YSINVENTORY_FIELD_SKU_LABEL"
            description="COM_YSINVENTORY_FIELD_SKU_DESC"
        />

        <field
            name="ysi_quantity"
            type="number"
            label="COM_YSINVENTORY_FIELD_QUANTITY_LABEL"
            description="COM_YSINVENTORY_FIELD_QUANTITY_DESC"
            default="1"
            min="1"
            step="1"
            required="true"
            filter="int"
        />

        <field
            name="ysi_status"
            type="list"
            label="COM_YSINVENTORY_FIELD_ASSET_STATUS_LABEL"
            description="COM_YSINVENTORY_FIELD_ASSET_STATUS_DESC"
            default="1"
            filter="int"
        >
            <option value="1">COM_YSINVENTORY_ASSET_STATUS_IN_STOCK</option>
            <option value="2">COM_YSINVENTORY_ASSET_STATUS_ON_LOAN</option>
            <option value="3">COM_YSINVENTORY_ASSET_STATUS_MAINTENANCE</option>
            <option value="4">COM_YSINVENTORY_ASSET_STATUS_LOST</option>
        </field>

        <field
            name="description"
            type="editor"
            label="JGLOBAL_DESCRIPTION"
            filter="\Joomla\CMS\Component\ComponentHelper::filterText"
            buttons="true"
        />

        <field
            name="published"
            type="list"
            label="JSTATUS"
            default="1"
            class="form-select-color-state"
            validate="options"
        >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="-2">JTRASHED</option>
        </field>

        <field
            name="ordering"
            type="number"
            label="JFIELD_ORDERING_LABEL"
            default="0"
            min="0"
            step="1"
            filter="int"
        />
    </fieldset>

    <fieldset name="tags" label="COM_YSINVENTORY_FIELDSET_TAGS">
        <field
            name="ysi_tags"
            type="sql"
            label="COM_YSINVENTORY_FIELD_TAGS_LABEL"
            description="COM_YSINVENTORY_FIELD_TAGS_DESC"
            multiple="true"
            key_field="value"
            value_field="text"
            layout="joomla.form.field.list-fancy-select"
            query="SELECT t.id AS value, CONCAT(tg.name, ' — ', t.name) AS text FROM #__ysi_tags AS t INNER JOIN #__ysi_tag_groups AS tg ON tg.id = t.ysi_tag_group_id WHERE t.published = 1 AND tg.published = 1 ORDER BY tg.ordering, tg.name, t.ordering, t.name"
        />
    </fieldset>

    <fields name="params">
        <fieldset name="basic" label="JGLOBAL_FIELDSET_BASIC">
        </fieldset>
    </fields>

    <fieldset name="publishing" label="JGLOBAL_FIELDSET_PUBLISHING">
        <field
            name="created"
            type="calendar"
            label="JGLOBAL_FIELD_CREATED_LABEL"
            translateformat="true"
            showtime="true"
            size="22"
            filter="user_utc"
        />

        <field
            name="created_by"
            type="user"
            label="JGLOBAL_FIELD_CREATED_BY_LABEL"
            filter="unset"
        />

        <field
            name="modified"
            type="calendar"
            label="JGLOBAL_FIELD_MODIFIED_LABEL"
            translateformat="true"
            showtime="true"
            size="22"
            readonly="true"
            filter="user_utc"
        />

        <field
            name="modified_by"
            type="user"
            label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
            readonly="true"
            filter="unset"
        />
    </fieldset>
</form>