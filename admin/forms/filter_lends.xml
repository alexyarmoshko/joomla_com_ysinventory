<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            inputmode="search"
            label="COM_YSINVENTORY_FILTER_LENDS_SEARCH_LABEL"
            description="COM_YSINVENTORY_FILTER_LENDS_SEARCH_DESC"
            hint="JSEARCH_FILTER"
        />

        <field
            name="ysi_status"
            type="list"
            label="COM_YSINVENTORY_FIELD_LEND_STATUS_LABEL"
            class="js-select-submit-on-change"
        >
            <option value="">COM_YSINVENTORY_SELECT_STATUS</option>
            <option value="1">COM_YSINVENTORY_LEND_STATUS_REQUESTED</option>
            <option value="2">COM_YSINVENTORY_LEND_STATUS_ON_LOAN</option>
            <option value="3">COM_YSINVENTORY_LEND_STATUS_RETURNED</option>
            <option value="4">COM_YSINVENTORY_LEND_STATUS_LOST</option>
            <option value="5">COM_YSINVENTORY_LEND_STATUS_RETURNED_DAMAGED</option>
            <option value="6">COM_YSINVENTORY_LEND_STATUS_RETURNED_OVERDUE</option>
            <option value="7">COM_YSINVENTORY_LEND_STATUS_CANCELLED</option>
            <option value="8">COM_YSINVENTORY_LEND_STATUS_DENIED</option>
        </field>

        <field
            name="ysi_item_id"
            type="sql"
            label="COM_YSINVENTORY_FIELD_LEND_ITEM_LABEL"
            class="js-select-submit-on-change"
            query="SELECT id AS value, name AS text FROM #__ysi_items ORDER BY name"
            key_field="value"
            value_field="text"
        >
            <option value="">COM_YSINVENTORY_SELECT_ITEM</option>
        </field>
    </fields>

    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="JGLOBAL_SORT_BY"
            default="a.created DESC"
            class="js-select-submit-on-change"
            validate="options"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.created ASC">COM_YSINVENTORY_LEND_ORDERING_CREATED_ASC</option>
            <option value="a.created DESC">COM_YSINVENTORY_LEND_ORDERING_CREATED_DESC</option>
            <option value="a.ysi_from ASC">COM_YSINVENTORY_LEND_ORDERING_FROM_ASC</option>
            <option value="a.ysi_from DESC">COM_YSINVENTORY_LEND_ORDERING_FROM_DESC</option>
            <option value="a.ysi_status ASC">JSTATUS_ASC</option>
            <option value="a.ysi_status DESC">JSTATUS_DESC</option>
            <option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
            <option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
        </field>

        <field
            name="limit"
            type="limitbox"
            label="JGLOBAL_LIST_LIMIT"
            default="25"
            class="js-select-submit-on-change"
        />
    </fields>
</form>
