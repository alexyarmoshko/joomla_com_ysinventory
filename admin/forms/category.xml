<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fieldset>
        <field
            name="id"
            type="text"
            label="JGLOBAL_FIELD_ID_LABEL"
            default="0"
            class="readonly"
            readonly="true"
        />

        <field
            name="title"
            type="text"
            label="JGLOBAL_TITLE"
            required="true"
            size="40"
        />

        <field
            name="alias"
            type="text"
            label="JFIELD_ALIAS_LABEL"
            description="JFIELD_ALIAS_DESC"
            hint="JFIELD_ALIAS_PLACEHOLDER"
            size="40"
        />

        <field
            name="parent_id"
            type="sql"
            label="COM_YSINVENTORY_FIELD_CATEGORY_PARENT_LABEL"
            description="COM_YSINVENTORY_FIELD_CATEGORY_PARENT_DESC"
            default="0"
            query="SELECT id AS value, title AS text, level FROM #__ysi_categories WHERE id > 1 AND published IN (0, 1) ORDER BY lft"
            key_field="value"
            value_field="text"
            header="COM_YSINVENTORY_CATEGORY_SELECT_PARENT"
        >
            <option value="0">JNONE</option>
        </field>

        <field
            name="description"
            type="editor"
            label="JGLOBAL_DESCRIPTION"
            filter="\Joomla\CMS\Component\ComponentHelper::filterText"
            buttons="true"
        />

        <field
            name="published"
            type="list"
            label="JSTATUS"
            default="1"
            class="form-select-color-state"
            validate="options"
        >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="-2">JTRASHED</option>
        </field>

        <field
            name="access"
            type="accesslevel"
            label="JFIELD_ACCESS_LABEL"
            description="JFIELD_ACCESS_DESC"
            default="1"
        />

        <field
            name="language"
            type="contentlanguage"
            label="JFIELD_LANGUAGE_LABEL"
            description="JFIELD_LANGUAGE_DESC"
        >
            <option value="*">JALL</option>
        </field>
    </fieldset>

    <fields name="params">
        <fieldset name="basic" label="COM_YSINVENTORY_CATEGORY_FIELDSET_LENDING">
            <field
                name="ysi_lend_request_groups"
                type="usergrouplist"
                label="COM_YSINVENTORY_CONFIG_LEND_REQUEST_GROUPS_LABEL"
                description="COM_YSINVENTORY_CATEGORY_LEND_REQUEST_GROUPS_DESC"
                multiple="true"
                layout="joomla.form.field.list-fancy-select"
            />

            <field
                name="ysi_lend_moderation_groups"
                type="usergrouplist"
                label="COM_YSINVENTORY_CONFIG_LEND_MODERATION_GROUPS_LABEL"
                description="COM_YSINVENTORY_CATEGORY_LEND_MODERATION_GROUPS_DESC"
                multiple="true"
                layout="joomla.form.field.list-fancy-select"
            />

            <field
                name="ysi_lend_show_borrowings"
                type="list"
                label="COM_YSINVENTORY_CATEGORY_SHOW_BORROWINGS_LABEL"
                description="COM_YSINVENTORY_CATEGORY_SHOW_BORROWINGS_DESC"
                default=""
            >
                <option value="">COM_YSINVENTORY_USE_GLOBAL</option>
                <option value="1">JYES</option>
                <option value="0">JNO</option>
            </field>
        </fieldset>
    </fields>

    <fieldset name="metadata" label="JGLOBAL_FIELDSET_METADATA_OPTIONS">
        <field
            name="metadesc"
            type="textarea"
            label="JFIELD_META_DESCRIPTION_LABEL"
            description="JFIELD_META_DESCRIPTION_DESC"
            rows="3"
            cols="40"
        />

        <field
            name="metakey"
            type="textarea"
            label="JFIELD_META_KEYWORDS_LABEL"
            description="JFIELD_META_KEYWORDS_DESC"
            rows="3"
            cols="40"
        />
    </fieldset>

    <fieldset name="publishing" label="JGLOBAL_FIELDSET_PUBLISHING">
        <field
            name="created_time"
            type="calendar"
            label="JGLOBAL_FIELD_CREATED_LABEL"
            translateformat="true"
            showtime="true"
            size="22"
            filter="user_utc"
        />

        <field
            name="created_user_id"
            type="user"
            label="JGLOBAL_FIELD_CREATED_BY_LABEL"
            filter="unset"
        />

        <field
            name="modified_time"
            type="calendar"
            label="JGLOBAL_FIELD_MODIFIED_LABEL"
            translateformat="true"
            showtime="true"
            size="22"
            readonly="true"
            filter="user_utc"
        />

        <field
            name="modified_user_id"
            type="user"
            label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
            readonly="true"
            filter="unset"
        />
    </fieldset>

    <fieldset
        name="rules"
        label="JCONFIG_PERMISSIONS_LABEL"
    >
        <field
            name="rules"
            type="rules"
            label="JFIELD_RULES_LABEL"
            filter="rules"
            validate="rules"
            component="com_ysinventory"
            section="category"
        />
    </fieldset>
</form>
