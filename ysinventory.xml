<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">
    <name>com_ysinventory</name>
    <author>Yak Shaver</author>
    <creationDate>2026-02</creationDate>
    <copyright>(C) 2026 Yak Shaver https://www.kayakshaver.com</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>me@kayakshaver.com</authorEmail>
    <authorUrl>https://www.kayakshaver.com</authorUrl>
    <version>1.0.0</version>
    <description>COM_YSINVENTORY_XML_DESCRIPTION</description>
    <namespace path="src">YakShaver\Component\Ysinventory</namespace>

    <install>
        <sql>
            <file driver="mysql" charset="utf8mb4">sql/install.mysql.utf8mb4.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8mb4">sql/uninstall.mysql.utf8mb4.sql</file>
        </sql>
    </uninstall>
    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>

    <files folder="site">
        <folder>forms</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>
    <languages folder="site">
        <language tag="en-GB">language/en-GB/com_ysinventory.ini</language>
    </languages>

    <media destination="com_ysinventory" folder="media/com_ysinventory">
    </media>

    <administration>
        <menu img="class:archive" link="option=com_ysinventory">COM_YSINVENTORY</menu>
        <submenu>
            <menu link="option=com_ysinventory&amp;view=inventories" view="inventories"
                img="class:archive" alt="Ysinventory/Inventories">
                COM_YSINVENTORY_SUBMENU_INVENTORIES</menu>
            <menu link="option=com_ysinventory&amp;view=categories" view="categories"
                img="class:folder" alt="Ysinventory/Categories">COM_YSINVENTORY_SUBMENU_CATEGORIES</menu>
            <menu link="option=com_ysinventory&amp;view=brands" view="brands" img="class:bookmark"
                alt="Ysinventory/Brands">COM_YSINVENTORY_SUBMENU_BRANDS</menu>
            <menu link="option=com_ysinventory&amp;view=taggroups" view="taggroups" img="class:tags"
                alt="Ysinventory/TagGroups">COM_YSINVENTORY_SUBMENU_TAGGROUPS</menu>
            <menu link="option=com_ysinventory&amp;view=tags" view="tags" img="class:tag"
                alt="Ysinventory/Tags">COM_YSINVENTORY_SUBMENU_TAGS</menu>
            <menu link="option=com_ysinventory&amp;view=items" view="items" img="class:cube"
                alt="Ysinventory/Items">COM_YSINVENTORY_SUBMENU_ITEMS</menu>
            <menu link="option=com_ysinventory&amp;view=lends" view="lends" img="class:list-2"
                alt="Ysinventory/Lends">COM_YSINVENTORY_SUBMENU_LENDS</menu>
        </submenu>
        <files folder="admin">
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <folder>forms</folder>
            <folder>language</folder>
            <folder>services</folder>
            <folder>sql</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
        </files>
        <languages folder="admin">
            <language tag="en-GB">language/en-GB/com_ysinventory.ini</language>
            <language tag="en-GB">language/en-GB/com_ysinventory.sys.ini</language>
        </languages>
    </administration>
</extension>
