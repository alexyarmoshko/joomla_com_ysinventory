<?xml version="1.0" encoding="UTF-8"?>
<metadata>
    <layout title="COM_YSINVENTORY_TAG_VIEW_DEFAULT_TITLE"
        option="COM_YSINVENTORY_TAG_VIEW_DEFAULT_OPTION">
        <message>
            <![CDATA[COM_YSINVENTORY_TAG_VIEW_DEFAULT_DESC]]>
        </message>
    </layout>

    <fields name="request">
        <fieldset name="request">
            <field
                name="id"
                type="sql"
                label="COM_YSINVENTORY_FIELD_SELECT_TAG_LABEL"
                query="SELECT t.id AS value, CONCAT(tg.name, ' — ', t.name) AS text FROM #__ysi_tags AS t INNER JOIN #__ysi_tag_groups AS tg ON tg.id = t.ysi_tag_group_id WHERE t.published = 1 AND tg.published = 1 ORDER BY tg.ordering, tg.name, t.ordering, t.name"
                key_field="value"
                value_field="text"
                required="true"
            >
                <option value="">COM_YSINVENTORY_SELECT_TAG</option>
            </field>
        </fieldset>
    </fields>

    <fields name="params">
        <fieldset name="basic" label="JGLOBAL_FIELDSET_BASIC">
        </fieldset>
    </fields>
</metadata>
